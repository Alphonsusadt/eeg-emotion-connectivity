 "cells": [
  {
   "cell_type": "markdown",
   "id": "29be6a05",
   "metadata": {},
   "source": [
    "# Step 2: Partial Directed Coherence (PDC) Analysis\n",
    "## MVAR Model + PDC per Frequency Band\n",
    "\n",
    "**Input:** Preprocessed EEG `.npy` (62 channels, 100Hz)\n",
    "**Output:** PDC matrices per trial per band (delta, theta, alpha, beta, gamma)\n",
    "\n",
    "**Alur:**\n",
    "1. Load preprocessed EEG per trial\n",
    "2. Fit MVAR model (order dipilih oleh AIC, range 3-15)\n",
    "3. Compute PDC di frequency domain\n",
    "4. Average per frequency band\n",
    "5. Save results\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "50686efe",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Libraries imported\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import os\n",
    "import json\n",
    "import time\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from statsmodels.tsa.api import VAR\n",
    "from tqdm import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print(\"✓ Libraries imported\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2f8362a6",
   "metadata": {},
   "source": [
    "## 1. Konfigurasi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d785a3c3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Config loaded\n",
      "  Bands: ['delta', 'theta', 'alpha', 'beta', 'gamma']\n",
      "  MVAR order range: 3-15\n"
     ]
    }
   ],
   "source": [
    "INPUT_DIR = r\"D:\\Skripsi\\new_data\\00_preprocessing\\output\\preprocessed_eeg\"\n",
    "OUTPUT_DIR = r\"D:\\Skripsi\\new_data\\02_pdc\\output\\pdc_matrices\"\n",
    "FIGURES_DIR = r\"D:\\Skripsi\\new_data\\02_pdc\\output\\figures\"\n",
    "\n",
    "TARGET_FS = 100\n",
    "PDC_MAX_ORDER = 15\n",
    "PDC_MIN_ORDER = 3\n",
    "FREQUENCY_BANDS = {\n",
    "    \"delta\": (0.5, 4),\n",
    "    \"theta\": (4, 8),\n",
    "    \"alpha\": (8, 13),\n",
    "    \"beta\": (13, 30),\n",
    "    \"gamma\": (30, 45),\n",
    "}\n",
    "\n",
    "N_CHANNELS = 62\n",
    "TRIAL_LABELS = [1, 0, -1, -1, 0, 1, -1, 0, 1, 1, 0, -1, 0, 1, -1]\n",
    "EMOTION_MAP = {-1: \"negative\", 0: \"neutral\", 1: \"positive\"}\n",
    "\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "os.makedirs(FIGURES_DIR, exist_ok=True)\n",
    "\n",
    "print(f\"✓ Config loaded\")\n",
    "print(f\"  Bands: {list(FREQUENCY_BANDS.keys())}\")\n",
    "print(f\"  MVAR order range: {PDC_MIN_ORDER}-{PDC_MAX_ORDER}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3cf9459c",
   "metadata": {},
   "source": [
    "## 2. Fungsi MVAR & PDC"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "8c43d4b2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ MVAR & PDC functions defined\n"
     ]
    }
   ],
   "source": [
    "def fit_mvar(data, max_order=15, min_order=3):\n",
    "    \"\"\"\n",
    "    Fit MVAR model, select optimal order via AIC.\n",
    "    \n",
    "    Args:\n",
    "        data: (n_timepoints, n_channels)\n",
    "    \n",
    "    Returns:\n",
    "        model_fitted, optimal_order, coefficients (order, n_ch, n_ch)\n",
    "    \"\"\"\n",
    "    model = VAR(data)\n",
    "    \n",
    "    try:\n",
    "        order_result = model.select_order(maxlags=max_order)\n",
    "        optimal_order = order_result.aic\n",
    "        optimal_order = max(optimal_order, min_order)\n",
    "    except:\n",
    "        optimal_order = 5\n",
    "    \n",
    "    model_fitted = model.fit(maxlags=optimal_order)\n",
    "    \n",
    "    n_channels = data.shape[1]\n",
    "    coefficients = np.zeros((optimal_order, n_channels, n_channels))\n",
    "    for lag in range(optimal_order):\n",
    "        start = lag * n_channels\n",
    "        end = start + n_channels\n",
    "        if end <= model_fitted.params.shape[0]:\n",
    "            coefficients[lag] = model_fitted.params[start:end].T\n",
    "    \n",
    "    return model_fitted, optimal_order, coefficients\n",
    "\n",
    "def compute_pdc(coefficients, freqs, fs):\n",
    "    \"\"\"\n",
    "    Compute PDC from MVAR coefficients.\n",
    "    PDC_ij(f) = |A_ij(f)| / sqrt(sum_m |A_mj(f)|^2)\n",
    "    \"\"\"\n",
    "    order, n_ch, _ = coefficients.shape\n",
    "    n_freqs = len(freqs)\n",
    "    pdc = np.zeros((n_freqs, n_ch, n_ch))\n",
    "    \n",
    "    for f_idx, freq in enumerate(freqs):\n",
    "        A_f = np.eye(n_ch, dtype=complex)\n",
    "        for lag in range(1, order + 1):\n",
    "            exp_term = np.exp(-2j * np.pi * freq * lag / fs)\n",
    "            if lag - 1 < coefficients.shape[0]:\n",
    "                A_f -= coefficients[lag - 1] * exp_term\n",
    "        \n",
    "        for j in range(n_ch):\n",
    "            denom = np.sqrt(np.sum(np.abs(A_f[:, j]) ** 2))\n",
    "            if denom > 0:\n",
    "                for i in range(n_ch):\n",
    "                    pdc[f_idx, i, j] = np.abs(A_f[i, j]) / denom\n",
    "    \n",
    "    return pdc\n",
    "\n",
    "def average_over_bands(pdc, freqs, bands=None):\n",
    "    \"\"\"Average PDC over frequency bands.\"\"\"\n",
    "    bands = bands or FREQUENCY_BANDS\n",
    "    band_pdc = {}\n",
    "    \n",
    "    for band_name, (fmin, fmax) in bands.items():\n",
    "        mask = (freqs >= fmin) & (freqs <= fmax)\n",
    "        if np.sum(mask) > 0:\n",
    "            band_pdc[band_name] = np.mean(pdc[mask], axis=0)\n",
    "        else:\n",
    "            band_pdc[band_name] = np.zeros((pdc.shape[1], pdc.shape[2]))\n",
    "    \n",
    "    band_pdc['broadband'] = np.mean(pdc, axis=0)\n",
    "    return band_pdc\n",
    "\n",
    "print(\"✓ MVAR & PDC functions defined\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b686bc64",
   "metadata": {},
   "source": [
    "## 3. Test pada 1 Trial"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2e3a8fcc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Loaded: D:\\Skripsi\\new_data\\00_preprocessing\\output\\preprocessed_eeg\\subject_01\\session_20131027\\trial_01.npy\n",
      "  Shape: (62, 23501) @ 100Hz\n",
      "\n",
      "Fitting MVAR model (max_order=15)...\n",
      "✓ MVAR order: 15 (selected by AIC)\n",
      "  Time: 14.7s\n",
      "  Coefficients shape: (15, 62, 62)\n",
      "\n",
      "Computing PDC over 200 frequencies...\n",
      "\n",
      "--- PDC per Band ---\n",
      "  delta       : mean=0.0290, max=0.9951\n",
      "  theta       : mean=0.0282, max=0.9976\n",
      "  alpha       : mean=0.0276, max=0.9963\n",
      "  beta        : mean=0.0273, max=0.9913\n",
      "  gamma       : mean=0.0265, max=0.9923\n",
      "  broadband   : mean=0.0272, max=0.9736\n"
     ]
    }
   ],
   "source": [
    "sample_path = os.path.join(INPUT_DIR, \"subject_01\", \"session_20131027\", \"trial_01.npy\")\n",
    "eeg = np.load(sample_path)\n",
    "print(f\"Loaded: {sample_path}\")\n",
    "print(f\"  Shape: {eeg.shape} @ {TARGET_FS}Hz\")\n",
    "\n",
    "data = eeg.T  # (timepoints, channels)\n",
    "print(f\"\\nFitting MVAR model (max_order={PDC_MAX_ORDER})...\")\n",
    "t0 = time.time()\n",
    "model_fitted, optimal_order, coefficients = fit_mvar(data, PDC_MAX_ORDER, PDC_MIN_ORDER)\n",
    "t1 = time.time()\n",
    "print(f\"✓ MVAR order: {optimal_order} (selected by AIC)\")\n",
    "print(f\"  Time: {t1-t0:.1f}s\")\n",
    "print(f\"  Coefficients shape: {coefficients.shape}\")\n",
    "\n",
    "# Compute PDC\n",
    "freqs = np.linspace(0.5, TARGET_FS / 2, 200)\n",
    "print(f\"\\nComputing PDC over {len(freqs)} frequencies...\")\n",
    "pdc_full = compute_pdc(coefficients, freqs, TARGET_FS)\n",
    "band_pdc = average_over_bands(pdc_full, freqs)\n",
    "\n",
    "print(f\"\\n--- PDC per Band ---\")\n",
    "for band_name, pdc_matrix in band_pdc.items():\n",
    "    mean_val = pdc_matrix[pdc_matrix > 0].mean() if np.any(pdc_matrix > 0) else 0\n",
    "    print(f\"  {band_name:12s}: mean={mean_val:.4f}, max={pdc_matrix.max():.4f}\")\n"
   ]
  },
