   "source": [
    "import pandas as pd\n",
    "\n",
    "# Collect order info from metadata\n",
    "order_data = []\n",
    "for subj, sessions in metadata[\"subjects\"].items():\n",
    "    for sess, info in sessions.items():\n",
    "        order_data.append({\n",
    "            'subject': subj,\n",
    "            'session': sess,\n",
    "            'mean_order': info['mean_order']\n",
    "        })\n",
    "\n",
    "df_order = pd.DataFrame(order_data)\n",
    "print(\"=== MVAR Order Summary ===\")\n",
    "print(f\"Mean: {df_order['mean_order'].mean():.1f}\")\n",
    "print(f\"Range: {df_order['mean_order'].min():.0f} - {df_order['mean_order'].max():.0f}\")\n",
    "print()\n",
    "print(df_order.to_string())\n",
    "\n",
    "# Plot\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "df_order.groupby('subject')['mean_order'].mean().plot(kind='bar', ax=ax, color='steelblue')\n",
    "ax.set_title(\"Mean MVAR Order per Subject (selected by AIC)\")\n",
    "ax.set_ylabel(\"Order\")\n",
    "ax.axhline(y=df_order['mean_order'].mean(), color='red', linestyle='--', label=f\"Overall mean: {df_order['mean_order'].mean():.1f}\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGURES_DIR, \"mvar_order_analysis.png\"), dpi=150, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  }
 ],
