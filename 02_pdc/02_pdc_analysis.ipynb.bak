    "# Visualisasi PDC per band\n",
    "fig, axes = plt.subplots(2, 3, figsize=(18, 12))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for idx, (band_name, pdc_matrix) in enumerate(band_pdc.items()):\n",
    "    if idx >= 6:\n",
    "        break\n",
    "    ax = axes[idx]\n",
    "    sns.heatmap(pdc_matrix, cmap='hot', ax=ax, xticklabels=False, yticklabels=False,\n",
    "                vmin=0, vmax=pdc_matrix.max())\n",
    "    ax.set_title(f\"PDC {band_name}\")\n",
    "\n",
    "plt.suptitle(\"PDC per Frequency Band - Subject 1 Trial 1\", fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGURES_DIR, \"pdc_bands_test.png\"), dpi=150, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
