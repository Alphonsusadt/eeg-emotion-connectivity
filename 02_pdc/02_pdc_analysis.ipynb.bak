   "source": [
    "metadata = {\"fs\": TARGET_FS, \"subjects\": {}}\n",
    "total_trials = 0\n",
    "all_orders = []\n",
    "start_all = time.time()\n",
    "\n",
    "for subj_dir in sorted(os.listdir(INPUT_DIR)):\n",
    "    subj_path = os.path.join(INPUT_DIR, subj_dir)\n",
    "    if not os.path.isdir(subj_path):\n",
    "        continue\n",
    "    \n",
    "    metadata[\"subjects\"][subj_dir] = {}\n",
    "    \n",
    "    for sess_dir in sorted(os.listdir(subj_path)):\n",
    "        sess_path = os.path.join(subj_path, sess_dir)\n",
    "        if not os.path.isdir(sess_path):\n",
    "            continue\n",
    "        \n",
    "        out_dir = os.path.join(OUTPUT_DIR, subj_dir, sess_dir)\n",
    "        os.makedirs(out_dir, exist_ok=True)\n",
    "        \n",
    "        session_orders = []\n",
    "        start_sess = time.time()\n",
    "        \n",
    "        for trial_file in sorted(os.listdir(sess_path)):\n",
    "            if not trial_file.endswith('.npy'):\n",
    "                continue\n",
    "            \n",
    "            trial_idx = int(trial_file.split('_')[1].split('.')[0])\n",
    "            \n",
    "            eeg = np.load(os.path.join(sess_path, trial_file))\n",
    "            data = eeg.T\n",
    "            \n",
    "            _, optimal_order, coefficients = fit_mvar(data, PDC_MAX_ORDER, PDC_MIN_ORDER)\n",
    "            session_orders.append(optimal_order)\n",
    "            all_orders.append(optimal_order)\n",
    "            \n",
    "            freqs = np.linspace(0.5, TARGET_FS / 2, 200)\n",
    "            pdc_full = compute_pdc(coefficients, freqs, TARGET_FS)\n",
    "            band_pdc = average_over_bands(pdc_full, freqs)\n",
    "            \n",
    "            for band_name, pdc_matrix in band_pdc.items():\n",
    "                np.save(\n",
    "                    os.path.join(out_dir, f'pdc_{band_name}_trial_{trial_idx:02d}.npy'),\n",
    "                    pdc_matrix\n",
    "                )\n",
    "            total_trials += 1\n",
    "        \n",
    "        sess_time = time.time() - start_sess\n",
    "        metadata[\"subjects\"][subj_dir][sess_dir] = {\n",
    "            \"n_trials\": len(session_orders),\n",
    "            \"mean_order\": float(np.mean(session_orders)),\n",
    "            \"time_s\": round(sess_time, 1)\n",
    "        }\n",
    "        print(f\"  {subj_dir}/{sess_dir}: {len(session_orders)} trials, order={np.mean(session_orders):.1f}, time={sess_time:.0f}s\")\n",
    "\n",
    "total_time = time.time() - start_all\n",
    "metadata[\"total_trials\"] = total_trials\n",
    "metadata[\"total_time_min\"] = round(total_time / 60, 1)\n",
    "metadata[\"overall_mean_order\"] = float(np.mean(all_orders))\n",
    "\n",
    "meta_path = os.path.join(OUTPUT_DIR, \"pdc_metadata.json\")\n",
    "with open(meta_path, 'w') as f:\n",
    "    json.dump(metadata, f, indent=2)\n",
    "\n",
    "print(f\"\\n{'='*50}\")\n",
    "print(f\"✓ Done! {total_trials} trials in {total_time/60:.1f} min\")\n",
    "print(f\"  Mean MVAR order: {np.mean(all_orders):.1f}\")\n"
   ]
  },
