  {
   "cell_type": "markdown",
   "id": "06b0f740",
   "metadata": {
    "papermill": {
     "duration": null,
     "end_time": null,
     "exception": null,
     "start_time": null,
     "status": "pending"
    },
    "tags": []
   },
   "source": [
    "## Ringkasan & Plot\n",
    "\n",
    "Dijalankan setelah seluruh 45 sesi di atas selesai."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "02f0eec1",
   "metadata": {
    "papermill": {
     "duration": null,
     "end_time": null,
     "exception": null,
     "start_time": null,
     "status": "pending"
    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "order_data = []\n",
    "for subj, sessions in metadata['subjects'].items():\n",
    "    for sess, info in sessions.items():\n",
    "        order_data.append({'subject': subj, 'session': sess, 'mean_order': info['mean_order']})\n",
    "df_order = pd.DataFrame(order_data)\n",
    "print(f'Sessions recorded: {len(df_order)} / 45')\n",
    "print(f\"Overall mean order: {df_order['mean_order'].mean():.2f}\")\n",
    "per_subject = df_order.groupby('subject')['mean_order'].mean().sort_index()\n",
    "print(per_subject)\n",
    "\n",
    "csv_path = os.path.join(OUTPUT_DIR, 'mvar_order_per_subject.csv')\n",
    "per_subject.to_csv(csv_path)\n",
    "print('Saved:', csv_path)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "15a858b9",
   "metadata": {
    "papermill": {
     "duration": null,
     "end_time": null,
     "exception": null,
     "start_time": null,
     "status": "pending"
    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "overall_mean = df_order['mean_order'].mean()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "bars = ax.bar(per_subject.index, per_subject.values, color='steelblue')\n",
    "ax.axhline(y=overall_mean, color='red', linestyle='--',\n",
    "           label=f'Overall mean: {overall_mean:.1f}')\n",
    "for rect, val in zip(bars, per_subject.values):\n",
    "    ax.text(rect.get_x() + rect.get_width() / 2, val + 0.05, f'{val:.1f}',\n",
    "            ha='center', va='bottom', fontsize=18, fontweight='bold')\n",
    "\n",
    "ax.set_title('Mean MVAR Order per Subject (selected by AIC)', fontsize=26, fontweight='bold')\n",
    "ax.set_ylabel('Order', fontsize=20)\n",
    "ax.set_xlabel('subject', fontsize=20)\n",
    "ax.tick_params(axis='both', labelsize=17)\n",
    "plt.setp(ax.get_xticklabels(), rotation=90)\n",
    "ax.set_ylim(0, max(per_subject.values) * 1.15)\n",
    "ax.legend(fontsize=18)\n",
    "plt.tight_layout()\n",
    "\n",
    "out = os.path.join(OUTPUT_DIR, 'figures', 'mvar_order_analysis.png')\n",
    "os.makedirs(os.path.dirname(out), exist_ok=True)\n",
    "fig.savefig(out, dpi=150, bbox_inches='tight', facecolor='white')\n",
    "print('Saved:', out)\n"
   ]
  }
 ],
