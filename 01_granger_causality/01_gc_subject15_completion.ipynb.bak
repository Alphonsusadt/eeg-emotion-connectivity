   "source": [
    "# ============================================================\n",
    "# KONFIGURASI — sama persis dengan notebook GC utama\n",
    "# ============================================================\n",
    "INPUT_DIR  = r\"D:\\Skripsi\\new_data\\00_preprocessing\\output\\preprocessed_eeg\"\n",
    "OUTPUT_DIR = r\"D:\\Skripsi\\new_data\\01_granger_causality\\output\\gc_matrices\"\n",
    "FIGURES_DIR= r\"D:\\Skripsi\\new_data\\01_granger_causality\\output\\figures\"\n",
    "META_PATH  = os.path.join(OUTPUT_DIR, 'gc_metadata.json')\n",
    "\n",
    "# Parameter GC (identik dengan notebook utama)\n",
    "LAG_MIN             = 2\n",
    "LAG_MAX             = 5    # AIC selects best from 2-5\n",
    "PROPORTIONAL_RETAIN = 0.10 # Top 10% edges\n",
    "\n",
    "N_CHANNELS    = 62\n",
    "TARGET_FS     = 100\n",
    "TRIAL_LABELS  = [1, 0, -1, -1, 0, 1, -1, 0, 1, 1, 0, -1, 0, 1, -1]\n",
    "EMOTION_MAP   = {-1: 'negative', 0: 'neutral', 1: 'positive'}\n",
    "\n",
    "# HANYA SUBJECT 15\n",
    "TARGET_SUBJECT = 'subject_15'\n",
    "SUBJECT_15_SESSIONS = ['session_20130709', 'session_20131016', 'session_20131105']\n",
    "\n",
    "print('=' * 55)\n",
    "print('  GC COMPLETION RUN — SUBJECT 15 ONLY')\n",
    "print('=' * 55)\n",
    "print(f'  Input : {INPUT_DIR}')\n",
    "print(f'  Output: {OUTPUT_DIR}')\n",
    "print(f'  Target: {TARGET_SUBJECT}')\n",
    "print(f'  Sesi  : {SUBJECT_15_SESSIONS}')\n",
    "print(f'  Lag   : {LAG_MIN}–{LAG_MAX} (AIC optimal)')\n",
    "print(f'  Thresh: Proportional top {int(PROPORTIONAL_RETAIN*100)}%')\n",
    "print()\n",
    "\n",
    "# Cek input tersedia\n",
    "subj_input = os.path.join(INPUT_DIR, TARGET_SUBJECT)\n",
    "assert os.path.exists(subj_input), f'Input tidak ditemukan: {subj_input}'\n",
    "print(f'  ✅ Input folder ditemukan: {subj_input}')\n",
    "\n",
    "# Cek metadata existing\n",
    "if os.path.exists(META_PATH):\n",
    "    with open(META_PATH) as f:\n",
    "        existing_meta = json.load(f)\n",
    "    print(f'  ✅ Metadata existing ditemukan: {len(existing_meta[\"subjects\"])} subjek')\n",
    "    print(f'     Subjek dalam metadata: {list(existing_meta[\"subjects\"].keys())}')\n",
    "    print(f'  ⚠️  subject_15 ada di metadata? {TARGET_SUBJECT in existing_meta[\"subjects\"]}')\n",
    "else:\n",
    "    print(f'  ⚠️  Metadata tidak ditemukan, akan dibuat baru')\n",
    "    existing_meta = {'lag_min': LAG_MIN, 'lag_max': LAG_MAX,\n",
    "                     'threshold_method': f'proportional_{PROPORTIONAL_RETAIN}',\n",
    "                     'subjects': {}, 'total_trials': 0}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "m3",
   "metadata": {},
   "source": [
    "## Cell 3: Fungsi-fungsi GC (identik dengan notebook utama)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Semua fungsi GC didefinisikan ✅\n"
     ]
    }
   ],
   "source": [
    "# ============================================================\n",
    "# FUNGSI PREPROCESSING\n",
    "# ============================================================\n",
    "\n",
    "def check_stationarity(ts):\n",
    "    \"\"\"ADF test stasioneritas.\"\"\"\n",
    "    try:\n",
    "        result = adfuller(ts, autolag='AIC')\n",
    "        return result[1] < 0.05\n",
    "    except:\n",
    "        return False\n",
    "\n",
    "\n",
    "def make_stationary(data):\n",
    "    \"\"\"Differencing pada channel yang tidak stasioner.\"\"\"\n",
    "    n_timepoints, n_channels = data.shape\n",
    "    result = np.zeros_like(data)\n",
    "    for ch in range(n_channels):\n",
    "        ts = data[:, ch]\n",
    "        if not check_stationarity(ts):\n",
    "            ts_diff = np.diff(ts)\n",
    "            result[:len(ts_diff), ch] = ts_diff\n",
    "            result[len(ts_diff):, ch] = ts_diff[-1]\n",
    "        else:\n",
    "            result[:, ch] = ts\n",
    "    return result\n",
    "\n",
    "\n",
    "def normalize_channels(data):\n",
    "    \"\"\"Z-score normalization per channel.\"\"\"\n",
    "    mean = data.mean(axis=0, keepdims=True)\n",
    "    std  = data.std(axis=0, keepdims=True)\n",
    "    std[std < 1e-10] = 1.0\n",
    "    return (data - mean) / std\n",
    "\n",
    "\n",
    "def preprocess_for_gc(eeg_data):\n",
    "    \"\"\"Preprocess EEG: transpose → normalize → stationarize.\"\"\"\n",
    "    data = eeg_data.T          # (time, channels)\n",
    "    data = normalize_channels(data)\n",
    "    data = make_stationary(data)\n",
    "    return data\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FUNGSI KOMPUTASI GC\n",
    "# ============================================================\n",
    "\n",
    "def select_optimal_lag_aic(ts_j, ts_i, lag_min=2, lag_max=5):\n",
    "    \"\"\"Pilih lag optimal menggunakan AIC melalui VAR.\"\"\"\n",
    "    from statsmodels.tsa.api import VAR\n",
    "    try:\n",
    "        data_pair = np.column_stack([ts_j, ts_i])\n",
    "        model = VAR(data_pair)\n",
    "        res = model.select_order(maxlags=lag_max)\n",
    "        best_lag = max(res.aic, lag_min)\n",
    "        return min(best_lag, lag_max)\n",
    "    except:\n",
    "        return lag_min\n",
    "\n",
    "\n",
    "def compute_gc_pairwise(data, lag_min=2, lag_max=5):\n",
    "    \"\"\"\n",
    "    Compute pairwise GC dengan AIC-optimal lag per pasang.\n",
    "\n",
    "    Returns:\n",
    "        gc_matrix  : (n_ch, n_ch) F-statistic\n",
    "        p_matrix   : (n_ch, n_ch) p-values\n",
    "        lag_matrix : (n_ch, n_ch) optimal lag per pasang\n",
    "    \"\"\"\n",
    "    n_ch = data.shape[1]\n",
    "    gc_matrix  = np.zeros((n_ch, n_ch))\n",
    "    p_matrix   = np.ones((n_ch, n_ch))\n",
    "    lag_matrix = np.zeros((n_ch, n_ch), dtype=int)\n",
    "\n",
    "    total_pairs = n_ch * (n_ch - 1)\n",
    "    done = 0\n",
    "\n",
    "    for i in range(n_ch):\n",
    "        for j in range(n_ch):\n",
    "            if i == j:\n",
    "                continue\n",
    "            try:\n",
    "                test_data = data[:, [j, i]]   # j Granger-causes i\n",
    "                if np.any(np.isnan(test_data)) or np.any(np.isinf(test_data)):\n",
    "                    done += 1\n",
    "                    continue\n",
    "\n",
    "                # Pilih lag optimal\n",
    "                opt_lag = select_optimal_lag_aic(\n",
    "                    data[:, j], data[:, i], lag_min, lag_max)\n",
    "\n",
    "                result = grangercausalitytests(\n",
    "                    test_data, maxlag=opt_lag, verbose=False)\n",
    "\n",
    "                f_stat = result[opt_lag][0]['ssr_ftest'][0]\n",
    "                p_val  = result[opt_lag][0]['ssr_ftest'][1]\n",
    "\n",
    "                gc_matrix[i, j]  = f_stat\n",
    "                p_matrix[i, j]   = p_val\n",
    "                lag_matrix[i, j] = opt_lag\n",
    "\n",
    "            except:\n",
    "                pass\n",
    "            done += 1\n",
    "\n",
    "    return gc_matrix, p_matrix, lag_matrix\n",
    "\n",
    "\n",
    "def apply_proportional_threshold(gc_matrix, retain_ratio=0.10):\n",
    "    \"\"\"Pertahankan hanya top retain_ratio% koneksi terkuat.\"\"\"\n",
    "    thresholded = gc_matrix.copy()\n",
    "    np.fill_diagonal(thresholded, 0)\n",
    "    nonzero = thresholded[thresholded > 0]\n",
    "    if len(nonzero) > 0:\n",
    "        cutoff = np.percentile(nonzero, (1.0 - retain_ratio) * 100)\n",
    "        thresholded[thresholded < cutoff] = 0\n",
    "    return thresholded\n",
    "\n",
    "\n",
    "def compute_density(gc_thresholded):\n",
    "    \"\"\"Hitung network density.\"\"\"\n",
    "    n_ch = gc_thresholded.shape[0]\n",
    "    n_possible = n_ch * (n_ch - 1)\n",
    "    n_edges = np.count_nonzero(gc_thresholded)\n",
    "    return n_edges / n_possible if n_possible > 0 else 0.0\n",
    "\n",
    "\n",
    "print('Semua fungsi GC didefinisikan ✅')"
   ]
  },
