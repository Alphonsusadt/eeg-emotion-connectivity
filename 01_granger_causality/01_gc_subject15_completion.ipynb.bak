      "  [41/45] DONE session_20131105/trial_11 (neutral) — 1350s, density=0.100 | ETA: 1.5h | elapsed: 1.28h\n",
      "  [42/45] DONE session_20131105/trial_12 (negative) — 1058s, density=0.100 | ETA: 0.9h | elapsed: 1.60h\n",
      "  [43/45] DONE session_20131105/trial_13 (neutral) — 966s, density=0.100 | ETA: 0.5h | elapsed: 1.89h\n",
      "  [44/45] DONE session_20131105/trial_14 (positive) — 1099s, density=0.100 | ETA: 0.3h | elapsed: 2.21h\n",
      "  [45/45] DONE session_20131105/trial_15 (negative) — 977s, density=0.100 | ETA: 0.0h | elapsed: 2.50h\n",
      "\n",
      "=================================================================\n",
      "  SELESAI — subject_15\n",
      "  Total   : 45 trial\n",
      "  Computed: 7  |  Skipped: 38  |  Errors: 0\n",
      "  Waktu   : 2.50 jam (149.8 menit)\n",
      "  Mean density: 0.1002\n",
      "=================================================================\n"
     ]
    }
   ],
   "source": [
    "# ============================================================\n",
    "# MAIN PROCESSING — Subject 15 GC\n",
    "# ============================================================\n",
    "\n",
    "os.makedirs(subj_output_path, exist_ok=True)\n",
    "\n",
    "subject_meta   = {}   # metadata per sesi\n",
    "all_densities  = []\n",
    "all_orders     = []\n",
    "processed      = 0\n",
    "skipped        = 0\n",
    "computed       = 0\n",
    "errors         = 0\n",
    "start_all      = time.time()\n",
    "\n",
    "print('=' * 65)\n",
    "print(f'  MULAI GC — {TARGET_SUBJECT} | {todo_count} trial tersisa')\n",
    "print(f'  Waktu mulai: {time.strftime(\"%Y-%m-%d %H:%M:%S\")}')\n",
    "print('=' * 65)\n",
    "print()\n",
    "\n",
    "for trial_info in trial_list:\n",
    "    sess_dir    = trial_info['sess_dir']\n",
    "    trial_file  = trial_info['trial_file']\n",
    "    trial_idx   = trial_info['trial_idx']\n",
    "    label       = trial_info['label']\n",
    "    already_done= trial_info['done']\n",
    "    sess_output = trial_info['sess_output']\n",
    "    emotion     = EMOTION_MAP[label]\n",
    "\n",
    "    # Pastikan folder sesi output ada\n",
    "    os.makedirs(sess_output, exist_ok=True)\n",
    "\n",
    "    # Path output file\n",
    "    gc_raw_path    = os.path.join(sess_output, f'gc_raw_trial_{trial_idx:02d}.npy')\n",
    "    p_mat_path     = os.path.join(sess_output, f'p_values_trial_{trial_idx:02d}.npy')\n",
    "    gc_lag_path    = os.path.join(sess_output, f'gc_lag_trial_{trial_idx:02d}.npy')\n",
    "    gc_thresh_path = os.path.join(sess_output, f'gc_thresholded_trial_{trial_idx:02d}.npy')\n",
    "\n",
    "    processed += 1\n",
    "\n",
    "    if already_done:\n",
    "        # SKIP — sudah ada\n",
    "        gc_thresh = np.load(gc_thresh_path)\n",
    "        density   = compute_density(gc_thresh)\n",
    "        all_densities.append(density)\n",
    "        skipped  += 1\n",
    "        print(f'  [{processed}/{total_count}] SKIP {sess_dir}/trial_{trial_idx:02d} '\n",
    "              f'({emotion}) — density={density:.3f}')\n",
    "    else:\n",
    "        # COMPUTE\n",
    "        try:\n",
    "            eeg_path = os.path.join(subj_input_path, sess_dir, trial_file)\n",
    "            eeg  = np.load(eeg_path)\n",
    "            data = preprocess_for_gc(eeg)\n",
    "\n",
    "            t0 = time.time()\n",
    "            gc_raw, p_mat, lag_mat = compute_gc_pairwise(\n",
    "                data, lag_min=LAG_MIN, lag_max=LAG_MAX)\n",
    "            gc_thresh = apply_proportional_threshold(\n",
    "                gc_raw, retain_ratio=PROPORTIONAL_RETAIN)\n",
    "            t1 = time.time()\n",
    "\n",
    "            density = compute_density(gc_thresh)\n",
    "            all_densities.append(density)\n",
    "            all_orders.append(int(lag_mat[lag_mat > 0].mean()) if lag_mat.any() else LAG_MIN)\n",
    "            computed += 1\n",
    "\n",
    "            # Simpan output\n",
    "            np.save(gc_raw_path,    gc_raw)\n",
    "            np.save(p_mat_path,     p_mat)\n",
    "            np.save(gc_lag_path,    lag_mat)\n",
    "            np.save(gc_thresh_path, gc_thresh)\n",
    "\n",
    "            elapsed = t1 - t0\n",
    "            elapsed_all = time.time() - start_all\n",
    "            remaining = total_count - processed\n",
    "            eta_s = remaining * elapsed\n",
    "            eta_h = eta_s / 3600\n",
    "\n",
    "            print(f'  [{processed}/{total_count}] DONE {sess_dir}/trial_{trial_idx:02d} '\n",
    "                  f'({emotion}) — {elapsed:.0f}s, density={density:.3f} '\n",
    "                  f'| ETA: {eta_h:.1f}h | elapsed: {elapsed_all/3600:.2f}h')\n",
    "\n",
    "        except Exception as e:\n",
    "            errors += 1\n",
    "            print(f'  [{processed}/{total_count}] ERROR {sess_dir}/trial_{trial_idx:02d} '\n",
    "                  f'({emotion}) — {str(e)[:80]}')\n",
    "\n",
    "# ============================================================\n",
    "# RINGKASAN\n",
    "# ============================================================\n",
    "total_time = time.time() - start_all\n",
    "\n",
    "print()\n",
    "print('=' * 65)\n",
    "print(f'  SELESAI — {TARGET_SUBJECT}')\n",
    "print(f'  Total   : {total_count} trial')\n",
    "print(f'  Computed: {computed}  |  Skipped: {skipped}  |  Errors: {errors}')\n",
    "print(f'  Waktu   : {total_time/3600:.2f} jam ({total_time/60:.1f} menit)')\n",
    "if all_densities:\n",
    "    print(f'  Mean density: {np.mean(all_densities):.4f}')\n",
    "print('=' * 65)"
   ]
  },
