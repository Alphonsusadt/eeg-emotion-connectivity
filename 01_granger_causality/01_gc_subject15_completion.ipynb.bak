   "source": [
    "# ============================================================\n",
    "# VERIFIKASI: Cek trial yang tersedia vs yang sudah selesai\n",
    "# ============================================================\n",
    "\n",
    "subj_input_path = os.path.join(INPUT_DIR, TARGET_SUBJECT)\n",
    "subj_output_path = os.path.join(OUTPUT_DIR, TARGET_SUBJECT)\n",
    "\n",
    "trial_list   = []   # Semua trial yang perlu diproses\n",
    "total_count  = 0\n",
    "done_count   = 0\n",
    "todo_count   = 0\n",
    "\n",
    "print(f'Verifikasi data {TARGET_SUBJECT}:')\n",
    "print('-' * 60)\n",
    "\n",
    "for sess_dir in sorted(os.listdir(subj_input_path)):\n",
    "    sess_input  = os.path.join(subj_input_path, sess_dir)\n",
    "    sess_output = os.path.join(subj_output_path, sess_dir)\n",
    "    if not os.path.isdir(sess_input):\n",
    "        continue\n",
    "\n",
    "    trial_files = sorted([f for f in os.listdir(sess_input) if f.endswith('.npy')])\n",
    "    sess_done = 0\n",
    "    sess_todo = 0\n",
    "\n",
    "    for tf in trial_files:\n",
    "        trial_idx = int(tf.split('_')[1].split('.')[0])\n",
    "\n",
    "        # Cek apakah output sudah ada (3 file: gc_raw, gc_lag, gc_thresholded)\n",
    "        gc_raw_path   = os.path.join(sess_output, f'gc_raw_trial_{trial_idx:02d}.npy')\n",
    "        gc_lag_path   = os.path.join(sess_output, f'gc_lag_trial_{trial_idx:02d}.npy')\n",
    "        gc_thresh_path= os.path.join(sess_output, f'gc_thresholded_trial_{trial_idx:02d}.npy')\n",
    "\n",
    "        already_done = (\n",
    "            os.path.exists(gc_raw_path) and\n",
    "            os.path.exists(gc_lag_path) and\n",
    "            os.path.exists(gc_thresh_path)\n",
    "        )\n",
    "\n",
    "        trial_list.append({\n",
    "            'sess_dir'   : sess_dir,\n",
    "            'trial_file' : tf,\n",
    "            'trial_idx'  : trial_idx,\n",
    "            'label'      : TRIAL_LABELS[trial_idx - 1],\n",
    "            'done'       : already_done,\n",
    "            'sess_output': sess_output,\n",
    "        })\n",
    "\n",
    "        if already_done:\n",
    "            sess_done += 1\n",
    "            done_count += 1\n",
    "        else:\n",
    "            sess_todo += 1\n",
    "            todo_count += 1\n",
    "        total_count += 1\n",
    "\n",
    "    status = '✅ DONE' if sess_todo == 0 else f'⏳ {sess_todo} remaining'\n",
    "    print(f'  {sess_dir}: {len(trial_files)} trial | done={sess_done} | todo={sess_todo} | {status}')\n",
    "\n",
    "print('-' * 60)\n",
    "print(f'TOTAL   : {total_count} trial')\n",
    "print(f'Selesai : {done_count} trial')\n",
    "print(f'Sisa    : {todo_count} trial  ← yang akan diproses')\n",
    "print()\n",
    "\n",
    "if todo_count == 0:\n",
    "    print('🎉 Subject 15 sudah LENGKAP! Tidak ada yang perlu diproses.')\n",
    "    print('   Lanjut ke Cell 6 untuk update metadata saja.')\n",
    "else:\n",
    "    est_hours = todo_count * 1600 / 3600\n",
    "    est_hours_min = todo_count * 1400 / 3600\n",
    "    est_hours_max = todo_count * 1900 / 3600\n",
    "    print(f'⏱️  Estimasi waktu: {est_hours_min:.1f}–{est_hours_max:.1f} jam ({est_hours:.1f} jam rata-rata)')\n",
    "    print(f'   Pastikan notebook tidak diinterrupt!')"
   ]
