    "\n",
    "print('=' * 65)\n",
    "print('  VERIFIKASI FINAL — STATUS SEMUA SUBJEK')\n",
    "print('=' * 65)\n",
    "\n",
    "all_complete = True\n",
    "total_files_all = 0\n",
    "\n",
    "for subj_dir in sorted(os.listdir(OUTPUT_DIR)):\n",
    "    subj_path = os.path.join(OUTPUT_DIR, subj_dir)\n",
    "    if not os.path.isdir(subj_path):\n",
    "        continue\n",
    "\n",
    "    subj_trials = 0\n",
    "    subj_sessions = []\n",
    "\n",
    "    for sess_dir in sorted(os.listdir(subj_path)):\n",
    "        sess_path = os.path.join(subj_path, sess_dir)\n",
    "        if not os.path.isdir(sess_path):\n",
    "            continue\n",
    "        thresh_count = len([f for f in os.listdir(sess_path)\n",
    "                             if 'thresholded' in f and f.endswith('.npy')])\n",
    "        subj_trials += thresh_count\n",
    "        subj_sessions.append(f'{sess_dir}({thresh_count})')\n",
    "\n",
    "    expected  = 45  # 3 sesi × 15 trial\n",
    "    status    = '✅' if subj_trials == expected else f'⚠️ ({subj_trials}/{expected})'\n",
    "    marker    = ' ← BARU' if subj_dir == TARGET_SUBJECT else ''\n",
    "    print(f'  {subj_dir}: {status} {subj_trials} trial{marker}')\n",
    "    total_files_all += subj_trials\n",
    "    if subj_trials != expected:\n",
    "        all_complete = False\n",
    "\n",
    "print('-' * 65)\n",
    "print(f'  Total trial GC: {total_files_all} (target: 675)')\n",
    "if all_complete and total_files_all == 675:\n",
    "    print('  🎉 SEMPURNA! Semua 15 subjek × 45 trial = 675 trial GC selesai!')\n",
    "else:\n",
