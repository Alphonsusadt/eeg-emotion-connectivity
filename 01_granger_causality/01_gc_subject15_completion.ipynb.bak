   "source": [
    "# ============================================================\n",
    "# UPDATE METADATA — Tambahkan Subject 15\n",
    "# ============================================================\n",
    "\n",
    "# Load metadata yang sudah ada (14 subjek)\n",
    "with open(META_PATH) as f:\n",
    "    meta = json.load(f)\n",
    "\n",
    "print(f'Metadata sebelum update: {len(meta[\"subjects\"])} subjek, {meta[\"total_trials\"]} trials')\n",
    "\n",
    "# Hitung statistik Subject 15 dari file output\n",
    "subj15_meta = {}\n",
    "subj15_densities = []\n",
    "subj15_trials = 0\n",
    "\n",
    "for sess_dir in sorted(os.listdir(subj_output_path)):\n",
    "    sess_output_dir = os.path.join(subj_output_path, sess_dir)\n",
    "    if not os.path.isdir(sess_output_dir):\n",
    "        continue\n",
    "\n",
    "    # Hitung file yang ada\n",
    "    thresh_files = sorted([f for f in os.listdir(sess_output_dir)\n",
    "                            if 'thresholded' in f and f.endswith('.npy')])\n",
    "    lag_files    = sorted([f for f in os.listdir(sess_output_dir)\n",
    "                            if 'lag' in f and f.endswith('.npy')])\n",
    "\n",
    "    sess_densities = []\n",
    "    sess_lags      = []\n",
    "\n",
    "    for tf in thresh_files:\n",
    "        mat = np.load(os.path.join(sess_output_dir, tf))\n",
    "        sess_densities.append(compute_density(mat))\n",
    "\n",
    "    for lf in lag_files:\n",
    "        lag_mat = np.load(os.path.join(sess_output_dir, lf))\n",
    "        nonzero_lags = lag_mat[lag_mat > 0]\n",
    "        if len(nonzero_lags) > 0:\n",
    "            sess_lags.append(float(nonzero_lags.mean()))\n",
    "\n",
    "    n_trials = len(thresh_files)\n",
    "    subj15_trials += n_trials\n",
    "    subj15_densities.extend(sess_densities)\n",
    "\n",
    "    subj15_meta[sess_dir] = {\n",
    "        'n_trials'    : n_trials,\n",
    "        'mean_density': float(np.mean(sess_densities)) if sess_densities else 0.0,\n",
    "        'mean_lag'    : float(np.mean(sess_lags))      if sess_lags      else LAG_MIN,\n",
    "    }\n",
    "\n",
    "    print(f'  {sess_dir}: {n_trials} trial, '\n",
    "          f'mean_density={np.mean(sess_densities):.4f}')\n",
    "\n",
    "# Update metadata\n",
    "meta['subjects'][TARGET_SUBJECT] = subj15_meta\n",
    "\n",
    "# Recount totals\n",
    "all_subject_trials = sum(\n",
    "    sum(s['n_trials'] for s in sessions.values())\n",
    "    for sessions in meta['subjects'].values()\n",
    ")\n",
    "meta['total_trials'] = all_subject_trials\n",
    "meta['overall_mean_density'] = float(np.mean(subj15_densities)) if subj15_densities else 0.0\n",
    "\n",
    "# Simpan\n",
    "with open(META_PATH, 'w') as f:\n",
    "    json.dump(meta, f, indent=2)\n",
    "\n",
    "print()\n",
    "print('=' * 55)\n",
    "print(f'  Metadata berhasil diperbarui!')\n",
    "print(f'  Subjek   : {len(meta[\"subjects\"])} (termasuk subject_15)')\n",
    "print(f'  Total trial: {meta[\"total_trials\"]} (harusnya 675)')\n",
    "print(f'  Mean density subject_15: {np.mean(subj15_densities):.4f}')\n",
    "print(f'  Disimpan ke: {META_PATH}')\n",
    "print('=' * 55)"
   ]
  },
